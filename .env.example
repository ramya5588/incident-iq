# Copy to .env (never commit .env) and fill in the values, then run:
#   docker compose -f compose.prod.yaml up -d --build

# Required. A long random password for the database, e.g. from
#   openssl rand -base64 32
DB_PASSWORD=change-me

# First admin, created only when the database has no accounts at all.
# Password: 12-72 characters. After signing in, change it on the Account
# page and remove INITIAL_ADMIN_PASSWORD from this file.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator

# Port the app is served on (http://localhost:8090 by default).
HTTP_PORT=8090

# Keep true when users reach the app over HTTPS (the normal case). Set to
# false only for a local trial over plain http on a non-localhost address.
COOKIE_SECURE=true

# AI triage: local (rule-based, no network) or openai.
AI_PROVIDER=local
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra

# Address people open the app at; used for links in emails.
APP_URL=http://localhost:8090

# Email notifications through your mail provider's SMTP server. Leave
# MAIL_HOST empty to keep notifications in-app only. MAIL_FROM is the sender,
# e.g. IncidentIQ <incidents@example.com>.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
